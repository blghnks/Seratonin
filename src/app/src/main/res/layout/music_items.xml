<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#111111"
    android:layout_marginTop="2dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:id="@+id/audio_item">

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:id="@+id/music_img"
        app:srcCompat="@drawable/musicicon"
        android:padding="5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:id="@+id/menuMore"
        app:srcCompat="@drawable/ic_baseline_more"
        android:padding="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/music_file_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="9dp"
        android:singleLine="true"
        android:text="File Name"
        android:textColor="#F1EAEA"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/music_img"
        app:layout_constraintEnd_toStartOf="@+id/menuMore"/>

    <TextView
        android:id="@+id/music_artist_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11.2dp"
        android:layout_marginTop="3dp"
        android:singleLine="true"
        android:text="Artist Name"
        android:textColor="#938B8B"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@+id/music_file_name"
        app:layout_constraintStart_toEndOf="@+id/music_img"
        app:layout_constraintEnd_toStartOf="@+id/duration"/>

    <TextView
        android:id="@+id/duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:singleLine="true"
        android:text="duration"
        android:textColor="#938B8B"
        android:textSize="11sp"
        app:layout_constraintTop_toBottomOf="@+id/music_file_name"
        app:layout_constraintEnd_toStartOf="@+id/menuMore"/>

</androidx.constraintlayout.widget.ConstraintLayout>