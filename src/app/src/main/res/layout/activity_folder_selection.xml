<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/folder_selection_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".FolderSelectionActivity">

    <!-- Header Section -->
    <TextView
        android:id="@+id/app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginTop="@dimen/spacing_md"
        android:fontFamily="sans-serif-medium"
        android:text="Seratonin"
        android:textColor="@color/text_primary_dark"
        android:textSize="@dimen/text_title_large"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Welcome Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/welcome_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_md"
        android:layout_marginTop="@dimen/spacing_lg"
        app:cardBackgroundColor="@color/surface_elevated"
        app:cardCornerRadius="@dimen/album_card_radius"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_title">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <!-- Icon -->
            <ImageView
                android:id="@+id/folder_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_folder_music"
                app:tint="@color/accent_purple"
                android:contentDescription="Folder" />

            <!-- Title -->
            <TextView
                android:id="@+id/title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="Welcome to Seratonin"
                android:textSize="@dimen/text_title_medium"
                android:textStyle="bold"
                android:textColor="@color/text_primary_dark" />

            <!-- Description -->
            <TextView
                android:id="@+id/description_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="To play your music and display album art, please grant storage access and select your music folder."
                android:textSize="@dimen/text_body"
                android:textColor="@color/text_secondary_dark"
                android:textAlignment="center"
                android:lineSpacingMultiplier="1.3" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Status Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/status_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_md"
        android:layout_marginTop="@dimen/spacing_md"
        app:cardBackgroundColor="@color/surface_dark"
        app:cardCornerRadius="@dimen/album_card_radius"
        app:cardElevation="0dp"
        app:strokeColor="@color/divider_dark"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/welcome_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Status Text -->
            <TextView
                android:id="@+id/status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Step 1: Grant storage permission"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                android:textColor="@color/accent_purple"
                android:drawablePadding="@dimen/spacing_sm" />

            <!-- Selected Folder Text -->
            <TextView
                android:id="@+id/selected_folder_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="Selected: /storage/emulated/0/Music"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/text_tertiary_dark"
                android:visibility="gone"
                android:ellipsize="middle"
                android:singleLine="true"
                android:background="@drawable/folder_path_background"
                android:padding="@dimen/spacing_sm" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons Section -->
    <LinearLayout
        android:id="@+id/buttons_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_md"
        android:layout_marginTop="@dimen/spacing_lg"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/status_card">

        <!-- Grant Permission Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/grant_permission_btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Grant Storage Permission"
            android:textSize="@dimen/text_body"
            android:textAllCaps="false"
            android:textStyle="bold"
            app:backgroundTint="@color/accent_purple"
            app:cornerRadius="@dimen/album_card_radius"
            app:icon="@drawable/ic_shield"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/spacing_sm"
            app:rippleColor="@color/accent_purple_dim" />

        <!-- Select Folder Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/select_folder_btn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="Select Music Folder"
            android:textSize="@dimen/text_body"
            android:textAllCaps="false"
            android:textColor="@color/text_primary_dark"
            android:enabled="false"
            app:cornerRadius="@dimen/album_card_radius"
            app:icon="@drawable/ic_folder_open"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/spacing_sm"
            app:iconTint="@color/accent_purple"
            app:strokeColor="@color/divider_dark"
            app:strokeWidth="1dp"
            app:rippleColor="@color/accent_purple_dim" />

    </LinearLayout>

    <!-- Info Text at bottom -->
    <TextView
        android:id="@+id/info_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:text="Seratonin will only scan the folder you select, not your entire device."
        android:textSize="@dimen/text_caption"
        android:textColor="@color/text_tertiary_dark"
        android:textAlignment="center"
        android:drawableStart="@drawable/ic_info"
        android:drawablePadding="@dimen/spacing_sm"
        android:drawableTint="@color/text_tertiary_dark"
        app:layout_constraintBottom_toTopOf="@id/continue_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Continue Button (Floating at bottom) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/continue_btn"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:text="Continue"
        android:textSize="@dimen/text_body"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:enabled="false"
        app:backgroundTint="@color/accent_purple"
        app:cornerRadius="@dimen/album_card_radius"
        app:icon="@drawable/ic_arrow_forward"
        app:iconGravity="end"
        app:iconPadding="@dimen/spacing_sm"
        app:rippleColor="@color/accent_purple_dim"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
