<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg"
    android:background="@color/surface_elevated">

    <TextView
        android:id="@+id/progress_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Caching Music Library"
        android:textColor="@color/text_primary_dark"
        android:textSize="@dimen/text_title_medium"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/spacing_md" />

    <TextView
        android:id="@+id/progress_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scanning files..."
        android:textColor="@color/text_secondary_dark"
        android:textSize="@dimen/text_body"
        android:layout_marginBottom="@dimen/spacing_md" />

    <ProgressBar
        android:id="@+id/progress_bar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/accent_purple"
        android:progressBackgroundTint="@color/divider_dark" />

    <TextView
        android:id="@+id/progress_percent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:gravity="end"
        android:text="0%"
        android:textColor="@color/text_secondary_dark"
        android:textSize="@dimen/text_caption" />

</LinearLayout>
