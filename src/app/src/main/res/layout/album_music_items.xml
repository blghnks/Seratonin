<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#111111"
    android:layout_marginTop="2dp"
    android:id="@+id/audio_item">

    <ImageView
        android:layout_width="57dp"
        android:layout_height="57dp"
        android:id="@+id/music_img"
        android:src="@drawable/musicicon"
        android:padding="5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:id="@+id/menuMore"
        app:srcCompat="@drawable/ic_baseline_more"
        android:layout_marginTop="8dp"
        android:padding="5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/music_file_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:singleLine="true"
        android:text="File Name"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/music_img"
        app:layout_constraintEnd_toStartOf="@+id/menuMore"/>

    <TextView
        android:id="@+id/artis_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10.5dp"
        android:layout_marginTop="2dp"
        android:text="Artist Name"
        android:singleLine="true"
        android:textColor="#837B7B"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@+id/music_file_name"
        app:layout_constraintStart_toEndOf="@+id/music_img"
        app:layout_constraintEnd_toStartOf="@+id/alb_duration"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:id="@+id/alb_duration"
        android:text="leng."
        android:textColor="#837B7B"
        android:textSize="11sp"
        app:layout_constraintTop_toBottomOf="@+id/music_file_name"
        app:layout_constraintEnd_toStartOf="@+id/menuMore"/>

</androidx.constraintlayout.widget.ConstraintLayout>