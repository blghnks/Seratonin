<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_lg"
    android:background="@color/surface_elevated">

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Edit Tags"
        android:textColor="@color/text_primary_dark"
        android:textSize="@dimen/text_title_medium"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/spacing_lg" />

    <!-- Song Title -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_song_title"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        android:hint="Song Title"
        app:boxStrokeColor="@color/accent_purple"
        app:hintTextColor="@color/accent_purple">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary_dark"
            android:inputType="text" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Album Title -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_album_title"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        android:hint="Album Title"
        app:boxStrokeColor="@color/accent_purple"
        app:hintTextColor="@color/accent_purple">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_album_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary_dark"
            android:inputType="text" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Year Released -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_year"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        android:hint="Year Released"
        app:boxStrokeColor="@color/accent_purple"
        app:hintTextColor="@color/accent_purple">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_year"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary_dark"
            android:inputType="number"
            android:maxLength="4" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Album Artist -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_album_artist"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_md"
        android:hint="Album Artist"
        app:boxStrokeColor="@color/accent_purple"
        app:hintTextColor="@color/accent_purple">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_album_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary_dark"
            android:inputType="text" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Song Artist -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_song_artist"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:hint="Song Artist"
        app:boxStrokeColor="@color/accent_purple"
        app:hintTextColor="@color/accent_purple">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_song_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary_dark"
            android:inputType="text" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Button Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/text_secondary_dark" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="Save"
            android:backgroundTint="@color/accent_purple" />

    </LinearLayout>

</LinearLayout>
